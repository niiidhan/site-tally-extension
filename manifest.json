{
  "manifest_version": 3,
  "name": "site-tally",
  "version": "1.0.0",
  "description": "Tracks the websites you visit and shows visit counts filtered by today, this week, or all time.",
  "permissions": ["webNavigation", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
